datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// ENUMS (Tipe Data Pilihan Terstruktur)
// ------------------------------------------------------

enum Role {
  ADMIN
  MEMBER
  TRAINER
}

enum Gender {
  MALE
  FEMALE
}

enum PackageType {
  DAILY    // Paket Harian (Daily Pass)
  MONTHLY  // Paket Bulanan (Basic, Regular, Premium)
}

enum Status {
  ACTIVE    // Aktif
  INACTIVE  // Tidak Aktif / Kadaluarsa
  PENDING   // Menunggu / Cuti
}

enum PaymentMethod {
  QRIS
  TRANSFER
  CASHIER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum AttendanceStatus {
  HADIR
  TIDAK_HADIR
}

// ------------------------------------------------------
// MODELS (Tabel Database MySQL)
// ------------------------------------------------------

// 1. Tabel User (Autentikasi & Akun Pengguna)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Password Akun
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi ke Profile, Trainer, & Transaksi
  profile      MemberProfile?
  trainer      Trainer?
  transactions Transaction[]

  @@map("users")
}

// 2. Tabel MemberProfile (Data Diri Member)
model MemberProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  memberCode String   @unique // Contoh: "GYM88-0012"
  name       String
  phone      String
  gender     Gender?  @default(MALE)
  joinedDate DateTime @default(now())
  status     Status   @default(ACTIVE)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relasi
  memberships Membership[]
  attendances Attendance[]

  @@map("member_profiles")
}

// 3. Tabel Trainer (Personal Trainer / Pelatih Gym)
model Trainer {
  id         String   @id @default(cuid())
  userId     String?  @unique // Opsional jika trainer diberi akses akun login
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  name       String
  specialty  String   // Contoh: "Bodybuilding & Muscle Gain", "Weight Loss"
  phone      String
  gender     Gender   @default(MALE)
  experience String?  // Contoh: "3 Tahun"
  status     Status   @default(ACTIVE)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("trainers")
}

// 4. Tabel Package (Master Data Paket Gym: Daily Pass & Bulanan)
model Package {
  id           String      @id @default(cuid())
  title        String      // Contoh: "Daily Pass", "Regular", "Premium"
  slug         String      @unique
  type         PackageType @default(MONTHLY)
  price        Decimal     @db.Decimal(12, 2)
  durationDays Int         // 1 hari untuk Daily Pass, 30/90/180 hari untuk Bulanan
  description  String?     @db.Text
  isPopular    Boolean     @default(false)
  isActive     Boolean     @default(true)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relasi
  memberships  Membership[]

  @@map("packages")
}

// 5. Tabel Membership (Masa Aktif Paket Member)
model Membership {
  id              String        @id @default(cuid())
  memberProfileId String
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  packageId       String
  package         Package       @relation(fields: [packageId], references: [id])

  startDate       DateTime      @default(now())
  endDate         DateTime
  status          Status        @default(ACTIVE)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relasi ke Transaksi Pembayaran
  transaction     Transaction?

  @@map("memberships")
}

// 6. Tabel Transaction (Transaksi & Pembayaran)
model Transaction {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // Contoh: "INV-20261018-001"
  userId        String
  user          User          @relation(fields: [userId], references: [id])

  membershipId  String?       @unique
  membership    Membership?   @relation(fields: [membershipId], references: [id])

  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(QRIS)
  paymentStatus PaymentStatus @default(PENDING)
  paidAt        DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("transactions")
}

// 7. Tabel Attendance (Log Kehadiran & Scan QR Code)
model Attendance {
  id              String           @id @default(cuid())
  memberProfileId String
  memberProfile   MemberProfile    @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  date            DateTime         @db.Date
  checkInTime     DateTime         @default(now())
  checkOutTime    DateTime?
  durationMinutes Int?             // Durasi latihan dalam menit
  status          AttendanceStatus @default(HADIR)
  notes           String?          // Keterangan opsional

  createdAt       DateTime         @default(now())

  @@map("attendances")
}